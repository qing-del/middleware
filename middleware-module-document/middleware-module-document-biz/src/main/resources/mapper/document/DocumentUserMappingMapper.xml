<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jacolp.document.infrastructure.persistence.mapper.DocumentUserMappingMapper">

    <resultMap id="DocumentUserMappingMap"
               type="com.jacolp.document.infrastructure.persistence.dataobject.DocumentUserMappingDO">
        <id column="document_id" property="documentId"/>
        <id column="user_id" property="userId"/>
        <result column="permission" property="permission"
                javaType="com.jacolp.document.enums.DocumentPermission"/>
        <result column="enabled" property="enabled"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectEnabledByDocumentIdAndUserId" resultMap="DocumentUserMappingMap">
        SELECT document_id, user_id, permission, enabled, create_time, update_time
        FROM biz_document_user
        WHERE document_id = #{documentId}
          AND user_id = #{userId}
          AND enabled = 1
    </select>
</mapper>
